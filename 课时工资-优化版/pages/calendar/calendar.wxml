<view class="page">
  <!-- 月份导航 -->
  <view class="nav card">
    <view class="nav-arrow" bindtap="goLastMonth">‹</view>
    <picker class="nav-picker" mode="date" fields="month" start="1901-01" end="2050-12"
            value="{{pickerValue}}" bindchange="bindMonthChange">
      <view class="nav-title">{{dateText}}<text class="nav-caret">▾</text></view>
    </picker>
    <view class="nav-arrow" bindtap="goNextMonth">›</view>
    <view class="nav-today" bindtap="goToday">今日</view>
  </view>

  <!-- 月历 -->
  <view class="card calendar">
    <view class="week-row">
      <view class="week {{index >= 5 ? 'wknd' : ''}}" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="days">
      <view wx:for="{{cells}}" wx:key="key"
            class="day-cell {{item.day ? '' : 'blank'}} {{item.weekday >= 6 ? 'wknd' : ''}} {{item.isToday ? 'today' : ''}}"
            bindtap="tapDay" data-index="{{index}}">
        <view class="day-num">{{item.day}}</view>
        <view class="day-lunar {{item.lunarHl ? 'hl' : ''}}">{{item.lunar}}</view>
        <view class="day-amount {{item.amount > 0 ? '' : 'zero'}}" wx:if="{{item.hasCourse}}">{{item.amount}}</view>
      </view>
    </view>
  </view>

  <!-- 月度统计 -->
  <view class="card summary" wx:if="{{subjects.length}}">
    <view class="sum-head">
      <text class="sum-label">本月工资</text>
      <view class="sum-total">{{total}}<text class="sum-unit">元</text></view>
    </view>
    <view class="sum-row sum-row-head">
      <view class="c-subject">科目</view>
      <view class="c-count">节数</view>
      <view class="c-price">课时费</view>
      <view class="c-sum">小计</view>
    </view>
    <view class="sum-row" wx:for="{{subjects}}" wx:key="subject">
      <view class="c-subject"><view class="dot" style="background:{{item.color}}"></view>{{item.subject}}</view>
      <view class="c-count">{{item.count}}节</view>
      <view class="c-price">{{item.price}}元</view>
      <view class="c-sum">{{item.sum}}元</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="card empty" wx:if="{{!hasTimetable}}">
    <view class="empty-icon">📅</view>
    <view class="empty-title">还没有课表</view>
    <view class="empty-desc">设置每周课程和课时费后，这里会自动统计每月工资</view>
    <button class="empty-btn" bindtap="goTimetable">去设置课表</button>
  </view>

  <!-- 当天课程抽屉 -->
  <view class="mask" wx:if="{{detail}}" bindtap="closeDetail" catchtouchmove="noop"></view>
  <view class="drawer" wx:if="{{detail}}" catchtouchmove="noop">
    <view class="drawer-head">
      <view class="drawer-title">{{detail.title}}</view>
      <view class="drawer-close" bindtap="closeDetail">✕</view>
    </view>
    <scroll-view scroll-y class="drawer-body">
      <view class="slot-item {{item.on ? '' : 'off'}}" wx:for="{{detail.list}}" wx:key="lesson"
            bindtap="toggleSlot" data-lesson="{{item.lesson}}">
        <view class="slot-lesson">第{{item.lesson}}节</view>
        <view class="slot-subject">{{item.subject}}</view>
        <view class="slot-price">{{item.price}}元</view>
        <view class="checkbox {{item.on ? 'checked' : ''}}"></view>
      </view>
      <view class="drawer-empty" wx:if="{{!detail.list.length}}">这天没有排课</view>
    </scroll-view>
    <view class="drawer-foot">
      <text class="drawer-foot-label">当日工资</text>
      <text class="drawer-foot-amount">{{detail.total}}元</text>
    </view>
    <view class="drawer-tip">点击课程可切换「计入 / 不计入」工资</view>
  </view>
</view>
