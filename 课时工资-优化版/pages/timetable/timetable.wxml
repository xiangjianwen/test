<view class="page">
  <view class="tip">点击任意格子设置该时段的课程与课时费</view>

  <!-- 课表网格 -->
  <view class="card tt">
    <view class="tt-head-row">
      <view class="tt-corner">节\周</view>
      <view class="tt-head {{index >= 5 ? 'wknd' : ''}}" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="tt-row" wx:for="{{rows}}" wx:for-item="row" wx:key="key">
      <view class="tt-lesson">{{row.lesson}}</view>
      <view class="tt-cell {{cell.subject ? 'filled' : ''}}"
            wx:for="{{row.cells}}" wx:for-item="cell" wx:key="key"
            style="{{cell.subject ? 'background:' + cell.color + '22;border-color:' + cell.color : ''}}"
            bindtap="tapCell" data-lesson="{{cell.lesson}}" data-weekday="{{cell.weekday}}">
        <text class="tt-subject" wx:if="{{cell.subject}}">{{cell.subject}}</text>
        <text class="tt-price" wx:if="{{cell.subject}}">{{cell.price}}元</text>
      </view>
    </view>
  </view>

  <!-- 科目汇总 -->
  <view class="card legend" wx:if="{{subjects.length}}">
    <view class="legend-title">课程与课时费</view>
    <view class="legend-item" wx:for="{{subjects}}" wx:key="subject">
      <view class="dot" style="background:{{item.color}}"></view>
      <text class="legend-name">{{item.subject}}</text>
      <text class="legend-price">{{item.price}}元/节</text>
      <text class="legend-count">每周{{item.count}}节</text>
    </view>
  </view>

  <!-- 危险操作 -->
  <view class="card danger">
    <view class="danger-btn" bindtap="clearTimetable">清空课表</view>
    <view class="danger-btn strong" bindtap="clearAllData">清空全部数据</view>
  </view>

  <!-- 编辑抽屉 -->
  <view class="mask" wx:if="{{edit}}" bindtap="closeEdit" catchtouchmove="noop"></view>
  <view class="drawer" wx:if="{{edit}}" catchtouchmove="noop">
    <view class="drawer-head">
      <view class="drawer-title">周{{weekdays[edit.weekday - 1]}} · 第{{edit.lesson}}节</view>
      <view class="drawer-close" bindtap="closeEdit">✕</view>
    </view>
    <view class="form">
      <view class="form-row">
        <text class="form-label">科目</text>
        <input class="form-input" value="{{edit.subject}}" bindinput="onSubjectInput"
               placeholder="如：数学" maxlength="10" focus="{{true}}" />
      </view>
      <view class="form-row">
        <text class="form-label">课时费</text>
        <input class="form-input" type="digit" value="{{edit.price}}" bindinput="onPriceInput"
               placeholder="元 / 节，如 40" />
      </view>
      <view class="chips" wx:if="{{subjects.length}}">
        <view class="chip" wx:for="{{subjects}}" wx:key="subject"
              bindtap="pickSubject" data-subject="{{item.subject}}">
          <view class="dot" style="background:{{item.color}}"></view>{{item.subject}}
        </view>
      </view>
    </view>
    <view class="drawer-actions">
      <button class="btn ghost" bindtap="clearCell">清除本节</button>
      <button class="btn primary" bindtap="saveEdit">保存</button>
    </view>
  </view>
</view>
