.page {
  padding-bottom: 40rpx;
}

/* 月份导航 */
.nav {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
}

.nav-arrow {
  width: 72rpx;
  height: 72rpx;
  line-height: 66rpx;
  text-align: center;
  font-size: 48rpx;
  color: var(--text-2);
  border-radius: 16rpx;
}

.nav-arrow:active {
  background: var(--primary-light);
}

.nav-picker {
  flex: 1;
}

.nav-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
}

.nav-caret {
  font-size: 24rpx;
  color: var(--text-3);
  margin-left: 8rpx;
}

.nav-today {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 999rpx;
}

/* 月历 */
.week-row {
  display: flex;
  padding: 16rpx 8rpx 4rpx;
}

.week {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
}

.week.wknd {
  color: #E34D59;
}

.days {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 8rpx 20rpx;
}

.day-cell {
  width: 14.2857%;
  height: 118rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 8rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
}

.day-cell:active {
  background: #F2F3F5;
}

.day-cell.blank {
  pointer-events: none;
}

.day-num {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 32rpx;
  border-radius: 50%;
}

.day-cell.wknd .day-num {
  color: #E34D59;
}

.day-cell.today .day-num {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

.day-lunar {
  font-size: 20rpx;
  color: var(--text-3);
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
}

.day-lunar.hl {
  color: var(--warn);
}

.day-amount {
  font-size: 20rpx;
  color: var(--primary);
  font-weight: 600;
}

.day-amount.zero {
  color: var(--text-3);
  font-weight: 400;
}

/* 月度统计 */
.sum-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
}

.sum-label {
  font-size: 28rpx;
  color: var(--text-2);
}

.sum-total {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--primary);
}

.sum-unit {
  font-size: 26rpx;
  font-weight: 400;
  margin-left: 6rpx;
}

.sum-row {
  display: flex;
  align-items: center;
  padding: 18rpx 32rpx;
  border-top: 1rpx solid var(--line);
}

.sum-row-head {
  color: var(--text-3);
  font-size: 24rpx;
  border-top: none;
  padding-top: 4rpx;
}

.c-subject {
  flex: 2.2;
  display: flex;
  align-items: center;
}

.c-count,
.c-price {
  flex: 1;
  text-align: right;
}

.c-sum {
  flex: 1.2;
  text-align: right;
  font-weight: 600;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

/* 空状态 */
.empty {
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-3);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.empty-btn {
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 0 60rpx;
  line-height: 2.6;
}

/* 当天课程抽屉 */
.drawer-body {
  max-height: 640rpx;
}

.slot-item {
  display: flex;
  align-items: center;
  padding: 22rpx 32rpx;
}

.slot-item:active {
  background: #F7F8FA;
}

.slot-item.off .slot-subject,
.slot-item.off .slot-price,
.slot-item.off .slot-lesson {
  opacity: 0.4;
}

.slot-lesson {
  width: 120rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

.slot-subject {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
}

.slot-price {
  font-size: 26rpx;
  color: var(--text-2);
  margin-right: 20rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  box-sizing: border-box;
}

.checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
  position: relative;
}

.checkbox.checked::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 6rpx;
  width: 12rpx;
  height: 22rpx;
  border: solid #fff;
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(45deg);
}

.drawer-empty {
  padding: 60rpx 0;
  text-align: center;
  color: var(--text-3);
  font-size: 28rpx;
}

.drawer-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 24rpx 32rpx 0;
  border-top: 1rpx solid var(--line);
}

.drawer-foot-label {
  font-size: 26rpx;
  color: var(--text-2);
}

.drawer-foot-amount {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
}

.drawer-tip {
  padding: 12rpx 32rpx 0;
  font-size: 22rpx;
  color: var(--text-3);
}
